# ─────────────────────────────────────────────────────────────────────────────
# Clasificados Colombia — environment template
#
# Copy to `.env` for local development. NEVER commit `.env`.
# Production values live in Coolify secrets (PRD Nº4 §56).
#
# Only NEXT_PUBLIC_* values may reach the browser (PRD Nº4 §59).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Public ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Postgres (server-only) ───────────────────────────────────────────────────
# Local dev matches docker-compose.dev.yml. Production uses a non-superuser
# application role (PRD Nº4 §14) and is never exposed to the internet (§13).
DATABASE_URL=postgresql://clasificados_app:clasificados_dev@localhost:55432/clasificados_dev

# ── Payload (server-only) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=replace-me-with-a-random-value-of-at-least-32-chars

# ── Meilisearch (server-only) — wired in F14 ─────────────────────────────────
# Master key never leaves the server (PRD Nº9 §113).
# Separate keys per role (PRD Nº4 §35): search-public / indexer / admin.
MEILI_HOST=http://localhost:57700
MEILI_MASTER_KEY=clasificados_dev_master_key_change_me
MEILI_INDEXER_KEY=
SEARCH_SCHEMA_VERSION=1

# ── MinIO Evidence Vault (server-only) — wired in F6 ─────────────────────────
# Never use root credentials from the application (PRD Nº5 §35).
# These keys must never be sent to the browser (PRD Nº5 §37).
MINIO_ENDPOINT=http://localhost:59000
MINIO_ACCESS_KEY=clasificados_dev_minio
MINIO_SECRET_KEY=clasificados_dev_minio_secret
MINIO_REGION=us-east-1

# ── Media pipeline — wired in F15 ────────────────────────────────────────────
MEDIA_PIPELINE_VERSION=1

# ─────────────────────────────────────────────────────────────────────────────
# NOT YET DEFINED — pending decisions tracked as gaps in
# docs/implementation/MASTER-IMPLEMENTATION-PLAN.md §3.2
#
#   G-10  SMTP provider          (blocks F2 password reset)
#   G-08  Newsletter provider    (blocks F10, F13)
#   G-09  Analytics tool         (blocks F16)
#   G-11  Error monitoring       (blocks F19)
# ─────────────────────────────────────────────────────────────────────────────
